  "components": {
    "schemas": {
      "CategoryDto": {
        "required": [
          "categoryName"
        ],
        "type": "object",
        "properties": {
          "categoryName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "distanceKm": {
            "maximum": 9999,
            "minimum": 0.01,
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "maximumParticipants": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "entryFee": {
            "maximum": 99999999,
            "minimum": 0,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "EnrolmentDto": {
        "type": "object",
        "properties": {
          "categoryID": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "EventDto": {
        "required": [
          "eventName",
          "eventType",
          "location"
        ],
        "type": "object",
        "properties": {
          "eventName": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "eventType": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "type": "string",
            "nullable": true
          },
          "eventDate": {
            "type": "string",
            "format": "date-time"
          },
          "startTime": {
            "type": "string",
            "format": "date-span"
          },
          "location": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterDto": {
        "required": [
          "email",
          "firstName",
          "lastName",
          "password"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 8,
            "type": "string"
          },
          "phone": {
            "maxLength": 30,
            "type": "string",
            "format": "tel",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ResultDto": {
        "required": [
          "resultStatus"
        ],
        "type": "object",
        "properties": {
          "enrolmentID": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "finishPosition": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "finishTime": {
            "type": "string",
            "format": "date-span",
            "nullable": true
          },
          "resultStatus": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RouteDto": {
        "required": [
          "finishPoint",
          "routeName",
          "startPoint"
        ],
        "type": "object",
        "properties": {
          "routeName": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "distanceKm": {
            "maximum": 9999,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "startPoint": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "finishPoint": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "routeInformation": {
            "maxLength": 1000,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateUserDto": {
        "required": [
          "email",
          "firstName",
          "lastName"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "phone": {
            "maxLength": 30,
            "type": "string",
            "format": "tel",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Enter your JWT token here.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
